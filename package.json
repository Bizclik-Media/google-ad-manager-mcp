{
  "name": "@bizclik/google-ad-manager-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Google Ad Manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bizclik-Media/google-ad-manager-mcp.git"
  },
  "type": "module",
  "bin": {
